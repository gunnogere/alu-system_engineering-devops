#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me with a 301 status code

apt-get update -y
apt-get install -y nginx

# Insert the redirection rule into the default server configuration using sed
sed -i '/server_name _;/a \    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }' /etc/nginx/sites-available/default

# Restart Nginx service
service nginx restart