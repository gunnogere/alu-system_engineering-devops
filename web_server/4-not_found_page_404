#!/usr/bin/env bash
# Install and configure Nginx with a custom 404 page

apt-get update -y
apt-get install -y nginx

# Create the default index page
echo "Holberton School must be Waka's favorite school on the ALU INTRANET!" \
> /var/www/html/index.html

# Create the custom 404 HTML page
echo "Ceci n'est pas une page" > /var/www/html/404.html

# Configure Nginx
cat > /etc/nginx/sites-available/default <<'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm;
    server_name _;

    # Redirect task
    location ^~ /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }

    # Custom 404 configuration
    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
EOF

# Test configuration and restart Nginx
nginx -t && service nginx restart