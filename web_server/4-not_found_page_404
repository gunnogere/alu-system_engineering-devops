#!/usr/bin/env bash
# Install and configure Nginx with a custom 404 page

apt-get update -y
apt-get install -y nginx

# Create the default index page
echo "Holberton School must be Waka's favorite school on the ALU INTRANET!" \
> /var/www/html/index.html

# Create the custom 404 page
cat > /var/www/html/5-design_a_beautiful_404_page.html <<'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>404 Not Found</title>
</head>
<body>
    Ceci n'est pas une page
</body>
</html>
EOF

# Configure Nginx
cat > /etc/nginx/sites-available/default <<'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm;
    server_name _;

    # Redirect task
    location ^~ /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }

    # Custom 404 page
    error_page 404 /5-design_a_beautiful_404_page.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
EOF

# Test configuration and restart Nginx
nginx -t || exit 1
service nginx restart