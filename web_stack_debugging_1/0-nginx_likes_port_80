#!/usr/bin/env bash
# Fix Nginx port 80 issue by stopping conflicting services and restarting Nginx

# Stop apache2 if running so port 80 is freed up
service apache2 stop 2>/dev/null || true

# Ensure the default Nginx configuration listens on port 80
sed -i 's/listen [0-9]\+/listen 80/g' /etc/nginx/sites-available/default 2>/dev/null || true

# Restart Nginx service
service nginx restart