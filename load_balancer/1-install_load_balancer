#!/usr/bin/env bash
# Configures HAProxy on a load balancer with round-robin distribution

# Update packages and install HAProxy
sudo apt-get update -y
sudo apt-get install -y haproxy

# Build HAProxy configuration block
HAPROXY_CONFIG="
frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7148-web-01 54.158.136.212:80 check
    server 7148-web-02 3.83.151.210:80 check
"

# Append configuration if not already present (prevents duplicates on re-runs)
if ! grep -q "frontend http_front" /etc/haproxy/haproxy.cfg; then
    echo "$HAPROXY_CONFIG" | sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null
fi

# Enable HAProxy init script
if ! grep -q "ENABLED=1" /etc/default/haproxy; then
    echo "ENABLED=1" | sudo tee -a /etc/default/haproxy > /dev/null
fi

# Restart HAProxy service to apply changes
sudo service haproxy restart
